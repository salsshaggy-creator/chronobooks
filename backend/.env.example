# Leave DATABASE_URL unset (or point at sqlite:./chronobooks.db) for local dev without Postgres.
# On Railway, set DATABASE_URL to the provisioned PostgreSQL connection string (Railway's
# Postgres plugin exposes this as a reference variable -- ${{Postgres.DATABASE_URL}}).
DATABASE_URL=sqlite:./chronobooks.db

PORT=4000
# On Railway, set this to "production" explicitly -- Railway does NOT set it for you.
# It controls the refresh-token cookie's SameSite/Secure flags (see auth.controller.js)
# and NODE_ENV-gated behavior elsewhere.
NODE_ENV=development
# Only matters for local dev, where the frontend runs on its own Vite dev server
# (localhost:5173) and the backend on its own port -- a real cross-origin setup. The
# production Docker image (see /Dockerfile) serves the built frontend from this same
# backend process on one origin, so CORS doesn't come into play there at all; you don't
# need to set this on Railway.
CORS_ORIGIN=http://localhost:5173

# Migrations run automatically on every boot (see server.js) -- schema_migrations tracks
# what's already applied, so this is safe to leave on. Set to "false" only if you're
# running migrations as a separate step in your own deploy pipeline instead.
AUTO_MIGRATE=true

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Leave unset to use the built-in mock payroll run (see src/services/chronosync.client.js).
# Point at a real ChronoSync instance to pull actual posted payroll runs instead.
CHRONOSYNC_API_URL=
CHRONOSYNC_API_TOKEN=

# AI Assistant — REQUIRED for the avatar to actually answer anything. This is a real
# OpenAI API key, billed to whoever's OpenAI account it belongs to (get one at
# platform.openai.com/api-keys, with billing enabled on that OpenAI account). Once set
# here, every company using this ChronoBooks installation gets the assistant for free
# — "free" means no per-company charge or license gate inside ChronoBooks, not that
# OpenAI itself is free to call. Without this set (and without any company adding its
# own key in Settings -> AI Assistant), the avatar will say it isn't configured yet.
PLATFORM_OPENAI_API_KEY=

# Secret used to encrypt any company-specific OpenAI key entered in Settings -> AI
# Assistant before it's stored. Change this to a random string in production.
AI_KEY_ENCRYPTION_SECRET=change-me-ai-key-encryption-secret
